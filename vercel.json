{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/trigger-daily-blogs",
      "schedule": "30 3 * * *"
    }
  ]
}
